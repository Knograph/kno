---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found" canonicalPath="/404/">
  <section class="section">
    <div class="container container--narrow">
      <p class="eyebrow">404</p>
      <h1>This page did not survive the holdout</h1>
      <p class="lede">
        Whatever lived here was measured, found to add nothing, and rejected with reason <code
          >no-effect</code
        >.
      </p>
      <p>
        <a class="btn btn--primary" href="/">Back to the homepage</a>
      </p>
    </div>
  </section>
</BaseLayout>
