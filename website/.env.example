# ---------------------------------------------------------------------------
# Kno website environment variables
#
# None of these are required to run the site locally. Copy to .env and edit
# as needed. Never commit real secrets — .env is gitignored.
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site. Used for canonical URLs, sitemap,
# RSS, OpenGraph, and the generated CMS config.
# Local default: http://localhost:4321
PUBLIC_SITE_URL=https://example.com

# Base URL of the Sveltia CMS Authenticator (Cloudflare Worker) that handles
# GitHub OAuth for /admin. Leave empty to use the GitHub access-token method
# when working in the CMS locally.
# Example: https://sveltia-cms-auth.knograph.workers.dev
CMS_AUTH_BASE_URL=

# ---------------------------------------------------------------------------
# Analytics (optional — the site works fully without any analytics)
# ---------------------------------------------------------------------------

# Set to "cloudflare" to enable Cloudflare Web Analytics custom events.
# Leave empty (or unset) to disable tracking entirely.
ANALYTICS_PROVIDER=

# Cloudflare Web Analytics token (site tag) if ANALYTICS_PROVIDER=cloudflare.
# https://developers.cloudflare.com/web-analytics/get-started/
CLOUDFLARE_ANALYTICS_TOKEN=

# ---------------------------------------------------------------------------
# Secrets — these belong ONLY in Cloudflare, never in the repo or .env.
# ---------------------------------------------------------------------------
# GITHUB_CLIENT_ID        # GitHub OAuth app Client ID for the CMS Worker
# GITHUB_CLIENT_SECRET    # GitHub OAuth app Client Secret for the CMS Worker
# ORIGIN_ALLOWLIST        # Comma-separated allowed origins for the CMS Worker
